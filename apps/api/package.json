{
  "name": "@skb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "dev": "node ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node ../../node_modules/vitest/vitest.mjs run --exclude src/db/pgvector-smoke.test.ts --exclude src/modules/documents/documents.integration.test.ts",
    "test:integration": "node ../../node_modules/vitest/vitest.mjs run src/modules/documents/documents.integration.test.ts",
    "lint": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "db:migrate": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/migrate.ts",
    "db:seed": "node ../../node_modules/tsx/dist/cli.mjs src/scripts/seed.ts",
    "db:smoke": "node ../../node_modules/vitest/vitest.mjs run src/db/pgvector-smoke.test.ts"
  },
  "dependencies": {
    "@skb/shared": "*",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
